<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;$(NetFrameworkMinimum);netstandard2.1;$(NetCoreAppMinimum);$(NetCoreAppCurrent)</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <!-- This assembly should never be placed inbox as it is only for downlevel compatibility. -->
    <PackageDescription>Provides downlevel support for System.Numerics APIs.</PackageDescription>
  </PropertyGroup>

  <Choose>
    <When Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netstandard2.1'))">
      <ItemGroup>
        <Compile Include="Microsoft.Bcl.Numerics.Forwards.cs" />
      </ItemGroup>
    </When>
  
    <Otherwise>
      <ItemGroup>
        <Compile Include="System\MathF.cs" />
      </ItemGroup>
    </Otherwise>
  </Choose>

  <ItemGroup Condition="'$(TargetFramework)' != '$(NetCoreAppCurrent)'">
    <Compile Include="$(CommonPath)System\Numerics\BigNumber.cs" Link="System\Numerics\BigNumber.cs" />
    <Compile Include="$(CommonPath)System\Numerics\BigNumber.BigArithmetic.cs" Link="System\Numerics\BigNumber.BigArithmetic.cs" />
    <Compile Include="$(CommonPath)System\Numerics\BigNumber.Conversions.cs" Link="System\Numerics\BigNumber.Conversions.cs" />
    <Compile Include="$(CommonPath)System\Numerics\BigNumber.Equality.cs" Link="System\Numerics\BigNumber.Equality.cs" />
    <Compile Include="$(CommonPath)System\Numerics\BigNumber.Formatting.cs" Link="System\Numerics\BigNumber.Formatting.cs" />
    <Compile Include="$(CommonPath)System\Numerics\BigNumber.Parsing.cs" Link="System\Numerics\BigNumber.Parsing.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == '$(NetCoreAppCurrent)'">
    <Compile Include="Microsoft.Bcl.Numerics.BigNumber.Forwards.cs" />
    <ProjectReference Include="$(LibrariesProjectRoot)System.Runtime.Numerics\src\System.Runtime.Numerics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Memory" Version="$(SystemMemoryVersion)" Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'netstandard2.1'))" />
  </ItemGroup>

</Project>
